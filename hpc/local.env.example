# Site-specific configuration for the Slurm submission helpers.
#
# Copy this file to hpc/local.env (git-ignored) on the machine that submits the
# jobs and fill in the values for your cluster. functions/pipeline_lib.sh and
# hpc/pull_source_file.sh source hpc/local.env automatically when it exists.

# Shared environment created by environment/restore.sh; one prefix for all stages.
BRAINOMICS_ENV_ROOT=/path/to/shared/brainomics-env

# Shared input data and run directory. Scripts are read from the current checkout.
BRAINOMICS_DATA_ROOT=/path/to/data/BrainOmicsData
BRAINOMICS_RUN_ROOT=/path/to/work/brainomics
BRAINOMICS_RESULTS_DIR=${BRAINOMICS_RUN_ROOT}/integration
BRAINOMICS_GENE_REFERENCE_DIR=${BRAINOMICS_DATA_ROOT}/raw/gene_references
BRAINOMICS_REFERENCE_RUN_ROOT=

BRAINOMICS_RPCA_MEMORY=

# HPC home directory used for transfer and log paths.
BRAINOMICS_HPC_ROOT=/path/to/hpc/home

# Slurm partitions for CPU and (if used) GPU jobs.
BRAINOMICS_HPC_PARTITION=your-cpu-partition
BRAINOMICS_HPC_GPU_PARTITION=your-gpu-partition

BRAINOMICS_CPU_CPUS=
BRAINOMICS_CPU_MEMORY=
BRAINOMICS_CPU_TIME=

# Directory for sbatch stdout/stderr logs; created on demand.
BRAINOMICS_HPC_LOG_DIR=/path/to/hpc/logs

# SSH endpoint used by hpc/pull_source_file.sh to copy source matrices.
BRAINOMICS_HPC_HOST=user@login-host
BRAINOMICS_HPC_PORT=22

# Data root on the cluster that holds the per-dataset source files.
BRAINOMICS_HPC_DATA_ROOT=/path/to/remote/data/BrainOmicsData
